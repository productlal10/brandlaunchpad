# ─── Production SMTP / Gmail (for Discovery Call email notifications) ────────
MAIL_TYPE=smtp
PROD_MAIL_HOST=smtp.gmail.com
PROD_MAIL_PORT=587
PROD_MAIL_USER=erpadmin@lal10.com
PROD_MAIL_PASS=your-16-char-app-password

# Backward-compatible aliases
GMAIL_USER=erpadmin@lal10.com
GMAIL_APP_PASS=your-16-char-app-password

# ─── External API / EC2 backend proxy (optional) ─────────────────────────────
# Set this to route all app /api calls through your EC2 backend, e.g.:
# EXTERNAL_API_BASE_URL=https://api.lal10.com
EXTERNAL_API_BASE_URL=
# Optional explicit Launchpad CSRF token endpoint.
# Example: EXTERNAL_AUTH_CSRF_URL=https://api.lal10.com/api/launchpad/auth/csrf-token
EXTERNAL_AUTH_CSRF_URL=

# Optional per-route overrides when the EC2 backend path does not match
EXTERNAL_AUTH_LOGIN_URL=
EXTERNAL_AUTH_ME_URL=
EXTERNAL_AUTH_LOGOUT_URL=
EXTERNAL_AUTH_SIGNUP_URL=
EXTERNAL_ADMIN_USERS_URL=
EXTERNAL_DISCOVERY_CALL_URL=
EXTERNAL_INSIGHTS_URL=
EXTERNAL_PARTNER_INQUIRY_URL=
EXTERNAL_TRENDS_URL=

# Leave this true until outbound email should be re-enabled intentionally.
DISABLE_OUTBOUND_EMAIL=true
LAUNCHPAD_MANUAL_USER_PROVISIONING=true
